<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Title of the first screen the user sees, where they enter the address of their
         Jellyfin server. -->
    <string name="feature_login_server_title">Connect to your server</string>
    <!-- Label of the text field for the server address. -->
    <string name="feature_login_server_address_label">Server address</string>
    <!-- Example shown in grey inside the empty server address field. A reserved example domain,
         the same in every language. -->
    <string name="feature_login_server_address_placeholder" translatable="false">music.example.com</string>
    <!-- Button that checks the entered server address. -->
    <string name="feature_login_connect">Connect</string>
    <!-- Shown on the connect button while the app tries to reach the server. -->
    <string name="feature_login_checking">Checking…</string>

    <!-- Error under the address field when the text can't be a web address. -->
    <string name="feature_login_error_invalid_address">This isn\'t a valid server address.</string>
    <!-- Error under the address field when no server answered at the address. -->
    <string name="feature_login_error_unreachable">Couldn\'t reach a server at this address. Check the address and your connection.</string>
    <!-- Error under the address field when the server uses HTTPS with a certificate the phone
         doesn't trust, e.g. an expired or self-signed one. -->
    <string name="feature_login_error_secure_connection">The server\'s security certificate isn\'t trusted.</string>
    <!-- Error under the address field when something answered at the address, but it isn't a
         Jellyfin server (e.g. a router's page). -->
    <string name="feature_login_error_not_jellyfin">Something answered at this address, but it isn\'t a Jellyfin server.</string>

    <!-- Shown after a failed connection when the app isn't allowed to reach devices on the
         user's home network (Android 17 and newer). -->
    <string name="feature_login_local_network_hint">If the server is on your home network, allow the app to find and connect to devices on your local network.</string>
    <!-- Button that asks for the local network permission. -->
    <string name="feature_login_allow_local_network">Allow local network access</string>

    <!-- Heading of the card shown once the server was found, above the server's name. -->
    <string name="feature_login_server_found">Server found</string>
    <!-- Button that moves on from the server screen once the server was found. -->
    <string name="feature_login_continue">Continue</string>
    <!-- Button that goes back to entering a different server address. -->
    <string name="feature_login_use_another_server">Use another server</string>

    <!-- Title of the screen where the user signs in to the server they just found. -->
    <string name="feature_login_sign_in_title">Sign in</string>
    <!-- Button next to the server's name and address at the top of the sign-in screen. Goes
         back to the previous screen to pick a different server. -->
    <string name="feature_login_change_server">Change server</string>
    <!-- Heading above the buttons with the names of the server's users. Tapping a name fills
         in the username. -->
    <string name="feature_login_public_users_label">Users on this server</string>
    <!-- Label of the text field for the Jellyfin username. -->
    <string name="feature_login_username_label">Username</string>
    <!-- Label of the text field for the password. -->
    <string name="feature_login_password_label">Password</string>
    <!-- Content description of the eye button in the password field while the password is hidden. -->
    <string name="feature_login_show_password">Show password</string>
    <!-- Content description of the eye button in the password field while the password is shown. -->
    <string name="feature_login_hide_password">Hide password</string>
    <!-- Button that signs in with the entered username and password. -->
    <string name="feature_login_sign_in">Sign in</string>
    <!-- Shown on the sign-in button while the server checks the username and password. -->
    <string name="feature_login_signing_in">Signing in…</string>

    <!-- Error under the password field when the server rejected the username or password. -->
    <string name="feature_login_error_wrong_credentials">Wrong username or password.</string>
    <!-- Error under the password field when the server didn't answer while signing in. -->
    <string name="feature_login_error_sign_in_unreachable">Couldn\'t reach the server. Check your connection and try again.</string>
    <!-- Error under the password field when the server answered with an error while signing in. -->
    <string name="feature_login_error_sign_in_server">The server couldn\'t sign you in. Try again later.</string>

    <!-- Button under the password form that opens the Quick Connect screen. "Quick Connect" is
         the name of a Jellyfin feature; use the name Jellyfin's own apps use in your language. -->
    <string name="feature_login_use_quick_connect">Use Quick Connect</string>
    <!-- Title of the screen where the user signs in by approving a code from another Jellyfin
         app. "Quick Connect" is the name of a Jellyfin feature. -->
    <string name="feature_login_quick_connect_title">Quick Connect</string>
    <!-- Shown above the six-digit code on the Quick Connect screen. -->
    <string name="feature_login_quick_connect_instructions">Enter this code in Quick Connect on another device that\'s signed in.</string>
    <!-- Shown next to a spinner while the app asks the server for a Quick Connect code. -->
    <string name="feature_login_quick_connect_requesting">Getting a code…</string>
    <!-- Shown next to a spinner under the code until the user approves it on another device. -->
    <string name="feature_login_quick_connect_waiting">Waiting for approval…</string>
    <!-- Shown when nobody approved the code in time and the server dropped it. -->
    <string name="feature_login_quick_connect_expired">This code expired.</string>
    <!-- Button shown after the code expired; asks the server for a new one. -->
    <string name="feature_login_quick_connect_new_code">Get a new code</string>
    <!-- Error when the server has Quick Connect turned off. -->
    <string name="feature_login_quick_connect_disabled">Quick Connect is turned off on this server.</string>
    <!-- Button shown after an error on the Quick Connect screen; asks the server for a code again. -->
    <string name="feature_login_try_again">Try again</string>
    <!-- Button at the bottom of the Quick Connect screen that goes back to signing in with a
         username and password. -->
    <string name="feature_login_use_password">Sign in with password</string>
</resources>
